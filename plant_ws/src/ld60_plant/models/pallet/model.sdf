<?xml version="1.0"?>
<!-- 600 x 450 x 80 mm plastic pallet (fits the 680 x 480 mm LD-60 roller top). Origin at its centre. -->
<sdf version="1.9">
  <model name="pallet">
    <link name="link">
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>0.087</ixx><iyy>0.153</iyy><izz>0.234</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- rounded front/back bottom edges (like real pallet runners) so the pallet rides over
           a small height step between two roller decks instead of catching on it -->
      <collision name="body">
        <geometry><box><size>0.52 0.45 0.08</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="nose_front">
        <pose>0.26 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.45</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="nose_back">
        <pose>-0.26 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.45</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="deck">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.60 0.45 0.02</size></box></geometry>
        <material><ambient>0.10 0.32 0.62 1</ambient><diffuse>0.10 0.32 0.62 1</diffuse></material>
      </visual>
      <visual name="runner_left">
        <pose>0 0.19 -0.01 0 0 0</pose>
        <geometry><box><size>0.60 0.07 0.06</size></box></geometry>
        <material><ambient>0.08 0.26 0.52 1</ambient><diffuse>0.08 0.26 0.52 1</diffuse></material>
      </visual>
      <visual name="runner_mid">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><box><size>0.60 0.07 0.06</size></box></geometry>
        <material><ambient>0.08 0.26 0.52 1</ambient><diffuse>0.08 0.26 0.52 1</diffuse></material>
      </visual>
      <visual name="runner_right">
        <pose>0 -0.19 -0.01 0 0 0</pose>
        <geometry><box><size>0.60 0.07 0.06</size></box></geometry>
        <material><ambient>0.08 0.26 0.52 1</ambient><diffuse>0.08 0.26 0.52 1</diffuse></material>
      </visual>
    </link>
    <!-- own pose only, so the AMR manager need not parse every entity of the plant (CPU) -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>
